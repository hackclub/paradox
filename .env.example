HACKCLUB_CLIENT_ID=your_client_id_here
HACKCLUB_CLIENT_SECRET=your_client_secret_here
# Must match the redirect URI registered at https://auth.hackclub.com
HACKCLUB_REDIRECT_URI=http://localhost:5173/api/auth/callback
ORIGIN=http://localhost:5173
NODE_ENV=development
# Umami analytics — https://umami.is
# PUBLIC_ vars are exposed to the browser (client-side page-view tracking)
PUBLIC_UMAMI_SCRIPT_URL=https://your-umami-instance.com/script.js
PUBLIC_UMAMI_WEBSITE_ID=your-website-id
# Private vars are used server-side for API usage / traffic tracking
# UMAMI_API_URL is the base URL of your Umami instance
# UMAMI_WEBSITE_ID is typically the same value as PUBLIC_UMAMI_WEBSITE_ID
UMAMI_API_URL=https://your-umami-instance.com
UMAMI_WEBSITE_ID=your-website-id
